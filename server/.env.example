# Every variable the server reads. docker-compose must name each one explicitly (plague-celo was bitten by env_file).
PORT=8787
# Comma-separated origins allowed to call the API and open the socket.
ALLOWED_ORIGINS=http://localhost:5173
# Postgres. Without it the server keeps accounts and runs in memory (fine for development, lost on restart).
DATABASE_URL=
# 32+ random characters. Signs the sign-in tokens.
JWT_SECRET=
# Where the task content files live: one JSON file per version, named <version>.json (the game's web/public/content/tasks.json is version 1's).
CONTENT_DIR=../web/public/content
# For smart-wallet (ERC-1271 / ERC-6492) signatures at sign-in. Without it only plain wallets (EOAs) can sign in.
CELO_RPC=https://forno.celo.org
CHAIN_ID=42220

# ── Staked rooms (off by default; read docs/PHASE2-BUILD-PLAN.md section 9 and get the owner's legal view first) ──
STAKED=false
# One PlagueRooms proxy per stake token on the chain above: SYMBOL=proxy, comma-separated. USDm has 18 decimals,
# USDT 6: each needs its own deploy (contracts/script/Deploy.s.sol) with stake limits in that token's units.
STAKE_STACKS=
# Each stake contract's deploy block, so the admin page's Funds view reads the whole history: "USDm=41596650,USDT=...".
# Optional: without it the first read walks back from the chain head to room #1.
STAKE_FROM_BLOCK=
# (older single-token form, read as USDm when STAKE_STACKS is empty)
ROOMS_ADDRESS=
# The BACKEND_ROLE key that settles finished rounds. It holds only gas (alert under 0.5 CELO on /health), never stakes.
# Admin of the contracts is a different key (a multisig for real money).
BACKEND_KEY=
# An account must be this old, and have this many replay-checked free runs, to sit in a staked room.
STAKED_MIN_ACCOUNT_HOURS=24
STAKED_MIN_OK_RUNS=3

# Wallets let into the admin page (/admin on the site). Holders of a stake contract's admin role get in too.
ADMIN_ADDRESSES=

# Armoury top-ups in a stablecoin (off while TOPUP_TOKEN is empty). The player sends the token to TOPUP_TREASURY from the
# wallet they signed in with; the server reads the transfer from the chain (CELO_RPC) and adds TOPUP_RATE ZP per token.
TOPUP_TOKEN=
TOPUP_TREASURY=
TOPUP_DECIMALS=18
TOPUP_RATE=1000
TOPUP_SYMBOL=USDm
