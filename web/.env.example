# Build-time settings for the game page (Vite reads VITE_*; they end up in the public page, so nothing secret here).
# The multiplayer / account server (WebSocket + HTTP). Defaults to the page's own host on :8787.
VITE_SERVER_URL=
# Google / passkey sign-in (a thirdweb client id; it is public by design). Without it only injected wallets sign in.
VITE_THIRDWEB_CLIENT_ID=
# Staked rooms: the PlagueRooms proxy, the stake token, the chain. Without the first two the staked lobby is not shown.
VITE_ROOMS_ADDRESS=
VITE_STAKE_TOKEN=
VITE_CHAIN_ID=42220
VITE_STAKE_SYMBOL=USDm
