# Copy to .env (never committed) and fill in.
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32 (changing it signs everyone out)
JWT_SECRET=
# The game page's addresses, comma-separated (and the Vercel preview address while testing)
ALLOWED_ORIGINS=https://zplague.xyz,https://www.zplague.xyz
# Wallets let into ?admin
ADMIN_ADDRESSES=
CELO_RPC=https://forno.celo.org
CHAIN_ID=42220
# Staked rooms stay off (docs/PHASE2-BUILD-PLAN.md section 9)
STAKED=false

# Armoury top-ups in a stablecoin (off while TOPUP_TOKEN is empty). The player sends the token to TOPUP_TREASURY from the
# wallet they signed in with; the server reads the transfer from the chain (CELO_RPC) and adds TOPUP_RATE ZP per token.
TOPUP_TOKEN=
TOPUP_TREASURY=
TOPUP_DECIMALS=18
TOPUP_RATE=1000
TOPUP_SYMBOL=USDm
